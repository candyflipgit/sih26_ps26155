# Inference endpoint. Any OpenAI-compatible host works; these defaults point at
# Groq, which serves open-weight models on a free tier.
#
#   Groq        https://api.groq.com/openai/v1          (get a key at console.groq.com)
#   OpenRouter  https://openrouter.ai/api/v1            (append :free to a model id)
#   HuggingFace https://router.huggingface.co/v1
#   Ollama      http://localhost:11434/v1               (no key needed, fully offline)
#
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# One request per scan rather than two. Benchmarked at 3.2s for 15
# commands; raising it further risks the model losing track of indices.
LLM_MAX_BATCH=16

# Leave false so no model output can become a compliance verdict without an
# administrator approving the mapping first.
AI_AUTOACCEPT=false
